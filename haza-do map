<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>大阪公立大高専 リアルタイム共同ハザードマップ</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Noto Sans JP', sans-serif;
        }
        #map {
            height: 100%;
            width: 100%;
            z-index: 1;
        }
        /* Custom scrollbar styling */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        /* Custom Leaflet Tooltip & Popup styling */
        .leaflet-popup-content-wrapper {
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        }
        /* Print Styles */
        @media print {
            .no-print {
                display: none !important;
            }
            .print-full {
                width: 100% !important;
                height: 100vh !important;
                position: absolute !important;
                top: 0 !important;
                left: 0 !important;
            }
            #map {
                border: none !important;
                box-shadow: none !important;
            }
        }
    </style>
</head>
<body class="bg-slate-100 h-screen flex flex-col overflow-hidden">

    <!-- App Header / Navbar -->
    <header class="bg-slate-900 text-white px-4 py-2.5 shadow-md flex justify-between items-center z-10 no-print border-b border-slate-800">
        <div class="flex items-center space-x-3">
            <div class="bg-blue-600 text-white p-2 rounded-xl shadow-lg flex items-center justify-center">
                <i class="fa-solid fa-graduation-cap text-lg"></i>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-base font-bold leading-tight tracking-wide">大阪公立大高専 防災マップ</h1>
                    <span id="sync-badge" class="bg-slate-700 text-slate-300 text-[10px] px-2 py-0.5 rounded-full flex items-center gap-1 font-medium transition-colors">
                        <span id="sync-dot" class="w-2 h-2 rounded-full bg-slate-400"></span>
                        <span id="sync-text">接続中...</span>
                    </span>
                </div>
                <p class="text-[11px] text-slate-400">リアルタイム共同編集・ハザードマップキャンバス</p>
            </div>
        </div>

        <div class="flex items-center space-x-2">
            <!-- Reset to OMCT Button -->
            <button onclick="resetToCollege()" class="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-1.5 rounded-lg text-xs font-bold transition flex items-center gap-1.5 shadow">
                <i class="fa-solid fa-location-crosshairs text-sm"></i>
                <span class="hidden sm:inline">高専を中心に表示</span>
            </button>

            <!-- Export/Import -->
            <button onclick="openExportModal()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-3 py-1.5 rounded-lg text-xs font-medium transition flex items-center gap-1">
                <i class="fa-solid fa-download text-xs"></i> <span class="hidden sm:inline">保存</span>
            </button>
            <button onclick="openImportModal()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-3 py-1.5 rounded-lg text-xs font-medium transition flex items-center gap-1">
                <i class="fa-solid fa-file-import text-xs"></i> <span class="hidden sm:inline">読込</span>
            </button>

            <!-- Print -->
            <button onclick="window.print()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-3 py-1.5 rounded-lg text-xs font-medium transition flex items-center gap-1">
                <i class="fa-solid fa-print text-xs"></i> <span class="hidden md:inline">印刷</span>
            </button>
        </div>
    </header>

    <!-- Main Container -->
    <div class="flex-1 flex relative overflow-hidden">

        <!-- Sidebar / Control Panel -->
        <aside id="sidebar" class="w-full md:w-96 bg-white border-r border-slate-200 flex flex-col z-20 transition-all duration-300 absolute md:relative h-full no-print shadow-2xl md:shadow-none -translate-x-full md:translate-x-0">
            
            <!-- Sidebar Navigation Tabs -->
            <div class="flex border-b border-slate-200 bg-slate-50 text-xs font-bold">
                <button onclick="switchTab('add')" id="tab-add" class="flex-1 py-3 text-blue-600 border-b-2 border-blue-600 flex justify-center items-center gap-1.5">
                    <i class="fa-solid fa-pen-to-square"></i> 追加・描画
                </button>
                <button onclick="switchTab('list')" id="tab-list" class="flex-1 py-3 text-slate-500 hover:text-slate-700 flex justify-center items-center gap-1.5">
                    <i class="fa-solid fa-list"></i> 登録一覧 (<span id="list-count">0</span>)
                </button>
                <button onclick="switchTab('stats')" id="tab-stats" class="flex-1 py-3 text-slate-500 hover:text-slate-700 flex justify-center items-center gap-1.5">
                    <i class="fa-solid fa-chart-pie"></i> 集計
                </button>
            </div>

            <!-- Tab Contents -->
            <div class="flex-1 overflow-y-auto p-4 space-y-4">

                <!-- TAB 1: ADD / DRAW -->
                <div id="content-add" class="space-y-4">
                    
                    <!-- Mode Selector -->
                    <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-2">
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">1. 描画モードを選択</label>
                        <div class="grid grid-cols-3 gap-2">
                            <button type="button" onclick="setDrawMode('marker')" id="btn-mode-marker" class="mode-btn bg-white border-2 border-blue-500 text-blue-600 p-2 rounded-xl text-center text-xs font-bold shadow-sm flex flex-col items-center gap-1">
                                <i class="fa-solid fa-location-dot text-base"></i> スポット
                            </button>
                            <button type="button" onclick="setDrawMode('route')" id="btn-mode-route" class="mode-btn bg-white border border-slate-200 text-slate-600 hover:bg-slate-100 p-2 rounded-xl text-center text-xs font-bold shadow-sm flex flex-col items-center gap-1">
                                <i class="fa-solid fa-route text-base"></i> 避難経路
                            </button>
                            <button type="button" onclick="setDrawMode('zone')" id="btn-mode-zone" class="mode-btn bg-white border border-slate-200 text-slate-600 hover:bg-slate-100 p-2 rounded-xl text-center text-xs font-bold shadow-sm flex flex-col items-center gap-1">
                                <i class="fa-solid fa-draw-polygon text-base"></i> 危険エリア
                            </button>
                        </div>
                    </div>

                    <!-- Mode Guide / Instructions -->
                    <div id="draw-instruction" class="bg-blue-50 border border-blue-200 text-blue-900 p-3 rounded-xl text-xs leading-relaxed">
                        <i class="fa-solid fa-circle-info text-blue-500 mr-1"></i> 地図上の任意の場所をクリックして、ピンを配置します。
                    </div>

                    <!-- Input Form -->
                    <form id="feature-form" onsubmit="handleFormSubmit(event)" class="space-y-3">
                        <input type="hidden" id="input-lat">
                        <input type="hidden" id="input-lng">
                        <input type="hidden" id="input-geojson">

                        <!-- Spot Mode Fields -->
                        <div id="fields-marker" class="space-y-3">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">カテゴリ <span class="text-red-500">*</span></label>
                                <select id="input-category" class="w-full text-xs font-medium border border-slate-300 rounded-lg p-2.5 bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                    <option value="shelter">🟢 指定避難所 / 避難場所</option>
                                    <option value="hazard">🔴 危険箇所 (崩落/浸水/崖/通行不可)</option>
                                    <option value="water">🔵 応急給水拠点 / 水道</option>
                                    <option value="aed">💖 AED設置場所</option>
                                    <option value="home">🏫 高専関連施設 / 拠 点</option>
                                    <option value="other">⚪ その他情報スポット</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">名称 / スポット名 <span class="text-red-500">*</span></label>
                                <input type="text" id="input-title" placeholder="例: 体育館 (広域避難場所)" required class="w-full text-xs border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">重要度 / 警戒度</label>
                                <select id="input-priority" class="w-full text-xs border border-slate-300 rounded-lg p-2.5 bg-white focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                    <option value="low">通常情報</option>
                                    <option value="medium" selected>注意・要確認</option>
                                    <option value="high">警戒・極めて危険</option>
                                </select>
                            </div>
                        </div>

                        <!-- Shape Mode Fields (Route & Zone) -->
                        <div id="fields-shape" class="space-y-3 hidden">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1">名称 / タイトル <span class="text-red-500">*</span></label>
                                <input type="text" id="input-shape-title" placeholder="例: 高専南側避難ルート / 浸水想定エリア" class="w-full text-xs border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 mb-1">表示カラー</label>
                                    <input type="color" id="input-shape-color" value="#ef4444" class="w-full h-9 rounded-lg border border-slate-300 p-1 cursor-pointer">
                                </div>
                                <div id="calc-distance-box" class="hidden flex flex-col justify-end">
                                    <span class="text-[10px] text-slate-500 font-bold">総距離 (概算)</span>
                                    <span id="route-distance-text" class="text-sm font-extrabold text-indigo-600">0.00 km</span>
                                </div>
                            </div>
                        </div>

                        <!-- Details Memo -->
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">詳細説明・メモ</label>
                            <textarea id="input-description" rows="3" placeholder="例: 大雨時に冠水しやすいため迂回が必要。夜間は照明が少ない。" class="w-full text-xs border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
                        </div>

                        <!-- Contact (Marker Only) -->
                        <div id="fields-contact">
                            <label class="block text-xs font-bold text-slate-700 mb-1">緊急連絡先・補足 (任意)</label>
                            <input type="text" id="input-contact" placeholder="例: 防災課 072-XXX-XXXX" class="w-full text-xs border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                        </div>

                        <button type="submit" id="btn-submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl text-xs shadow-md transition flex justify-center items-center gap-2">
                            <i class="fa-solid fa-cloud-arrow-up"></i> リアルタイムマップに登録
                        </button>
                    </form>
                </div>

                <!-- TAB 2: LIST & SEARCH -->
                <div id="content-list" class="space-y-3 hidden">
                    <!-- Search Input -->
                    <div class="relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-400 text-xs"></i>
                        <input type="text" id="search-list" oninput="renderList()" placeholder="キーワードで検索..." class="w-full text-xs pl-8 pr-3 py-2.5 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>

                    <!-- Category Quick Filter -->
                    <div class="flex gap-1 overflow-x-auto pb-1 text-[11px]">
                        <button onclick="filterList('all')" class="px-2.5 py-1 rounded-lg bg-slate-200 text-slate-700 font-bold hover:bg-slate-300 transition whitespace-nowrap">全て</button>
                        <button onclick="filterList('shelter')" class="px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 font-bold hover:bg-emerald-200 transition whitespace-nowrap">避難所</button>
                        <button onclick="filterList('hazard')" class="px-2.5 py-1 rounded-lg bg-red-100 text-red-800 font-bold hover:bg-red-200 transition whitespace-nowrap">危険箇所</button>
                        <button onclick="filterList('water')" class="px-2.5 py-1 rounded-lg bg-blue-100 text-blue-800 font-bold hover:bg-blue-200 transition whitespace-nowrap">給水</button>
                    </div>

                    <!-- Items Container -->
                    <div id="items-container" class="space-y-2">
                        <!-- Populated dynamically -->
                    </div>
                </div>

                <!-- TAB 3: STATS / DASHBOARD -->
                <div id="content-stats" class="space-y-4 hidden">
                    <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider">マップ共有データの集計</h3>
                    
                    <div class="grid grid-cols-2 gap-2.5">
                        <div class="bg-emerald-50 border border-emerald-200 p-3 rounded-xl flex items-center gap-3">
                            <div class="bg-emerald-500 text-white w-9 h-9 rounded-lg flex items-center justify-center text-sm shadow-sm">
                                <i class="fa-solid fa-person-shelter"></i>
                            </div>
                            <div>
                                <div class="text-[10px] text-emerald-700 font-bold">避難所</div>
                                <div class="text-lg font-extrabold text-emerald-900" id="stat-shelter">0</div>
                            </div>
                        </div>

                        <div class="bg-red-50 border border-red-200 p-3 rounded-xl flex items-center gap-3">
                            <div class="bg-red-500 text-white w-9 h-9 rounded-lg flex items-center justify-center text-sm shadow-sm">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </div>
                            <div>
                                <div class="text-[10px] text-red-700 font-bold">危険箇所</div>
                                <div class="text-lg font-extrabold text-red-900" id="stat-hazard">0</div>
                            </div>
                        </div>

                        <div class="bg-blue-50 border border-blue-200 p-3 rounded-xl flex items-center gap-3">
                            <div class="bg-blue-500 text-white w-9 h-9 rounded-lg flex items-center justify-center text-sm shadow-sm">
                                <i class="fa-solid fa-faucet-drip"></i>
                            </div>
                            <div>
                                <div class="text-[10px] text-blue-700 font-bold">給水所</div>
                                <div class="text-lg font-extrabold text-blue-900" id="stat-water">0</div>
                            </div>
                        </div>

                        <div class="bg-pink-50 border border-pink-200 p-3 rounded-xl flex items-center gap-3">
                            <div class="bg-pink-500 text-white w-9 h-9 rounded-lg flex items-center justify-center text-sm shadow-sm">
                                <i class="fa-solid fa-heart-pulse"></i>
                            </div>
                            <div>
                                <div class="text-[10px] text-pink-700 font-bold">AED</div>
                                <div class="text-lg font-extrabold text-pink-900" id="stat-aed">0</div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-slate-50 border border-slate-200 rounded-xl p-3 space-y-2 text-xs">
                        <div class="flex justify-between items-center text-slate-600">
                            <span>登録避難ルート数:</span>
                            <span class="font-bold text-slate-900" id="stat-route">0 ルート</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-600">
                            <span>危険/警戒エリア(面):</span>
                            <span class="font-bold text-slate-900" id="stat-zone">0 箇所</span>
                        </div>
                        <div class="flex justify-between items-center text-slate-600 border-t pt-2 mt-1">
                            <span>総要素登録数:</span>
                            <span class="font-bold text-blue-600 text-sm" id="stat-total">0</span>
                        </div>
                    </div>

                    <!-- User Info Card -->
                    <div class="bg-blue-50 border border-blue-100 rounded-xl p-3 text-xs space-y-1 text-blue-900">
                        <div class="font-bold flex items-center gap-1.5">
                            <i class="fa-solid fa-users text-blue-600"></i> リアルタイム共同編集モード
                        </div>
                        <p class="text-[11px] text-blue-700 leading-relaxed">
                            他のユーザーが追加したデータは、クラウド経由であなたの画面へリアルタイムに自動反映されます。
                        </p>
                    </div>
                </div>

            </div>

            <!-- Footer -->
            <div class="p-3 bg-slate-50 border-t border-slate-200 text-[11px] text-slate-500 flex justify-between items-center">
                <span>同期アイテム: <strong id="total-count" class="text-slate-800">0</strong> 件</span>
                <span id="user-id-display" class="font-mono text-[10px] text-slate-400">ID: ---</span>
            </div>
        </aside>

        <!-- Toggle Mobile Sidebar Floating Button -->
        <button onclick="toggleSidebar()" class="md:hidden fixed bottom-6 right-6 z-30 bg-blue-600 text-white p-4 rounded-full shadow-2xl no-print hover:bg-blue-500 transition">
            <i class="fa-solid fa-layer-group text-xl"></i>
        </button>

        <!-- Map Main Display Canvas -->
        <main class="flex-1 h-full relative print-full">
            <div id="map"></div>

            <!-- Legend Widget Overlay -->
            <div class="absolute bottom-6 left-6 bg-white/95 backdrop-blur border border-slate-200 p-3 rounded-2xl shadow-xl z-[400] text-xs space-y-2 no-print pointer-events-auto max-w-[220px]">
                <div class="font-bold text-slate-800 border-b border-slate-200 pb-1 flex justify-between items-center">
                    <span>凡例 (Legend)</span>
                    <i class="fa-solid fa-map text-slate-400"></i>
                </div>
                <div class="grid grid-cols-2 gap-x-2 gap-y-1.5 text-[11px]">
                    <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-emerald-500 inline-block shadow-sm"></span> 避難所</div>
                    <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-red-500 inline-block shadow-sm"></span> 危険箇所</div>
                    <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-blue-500 inline-block shadow-sm"></span> 給水拠点</div>
                    <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-pink-500 inline-block shadow-sm"></span> AED</div>
                    <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-amber-500 inline-block shadow-sm"></span> 高専施設</div>
                    <div class="flex items-center gap-1.5"><span class="w-3 h-1 bg-purple-500 inline-block rounded"></span> 避難経路</div>
                </div>
            </div>
        </main>
    </div>

    <!-- EXPORT MODAL -->
    <div id="modal-export" class="fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center hidden no-print backdrop-blur-sm">
        <div class="bg-white rounded-2xl p-6 w-full max-w-md shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="font-bold text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-file-export text-blue-600"></i> マップデータの保存・書き出し
                </h3>
                <button onclick="closeModal('modal-export')" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
                作成されたマップの全データを標準GeoJSONまたはCSVフォーマットでダウンロードします。
            </p>
            <div class="space-y-2 pt-2">
                <button onclick="exportGeoJSON()" class="w-full bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-xl font-bold text-xs transition flex items-center justify-between shadow">
                    <span class="flex items-center gap-2"><i class="fa-solid fa-code text-base"></i> GeoJSON形式で保存</span>
                    <span class="text-[10px] bg-blue-500 px-2 py-0.5 rounded text-white">標準推奨</span>
                </button>
                <button onclick="exportCSV()" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 p-3 rounded-xl font-bold text-xs transition flex items-center justify-between">
                    <span class="flex items-center gap-2"><i class="fa-solid fa-file-csv text-base"></i> CSV形式 (スポット一覧)</span>
                    <span class="text-[10px] text-slate-500">Excel用</span>
                </button>
            </div>
        </div>
    </div>

    <!-- IMPORT MODAL -->
    <div id="modal-import" class="fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center hidden no-print backdrop-blur-sm">
        <div class="bg-white rounded-2xl p-6 w-full max-w-md shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="font-bold text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-file-import text-blue-600"></i> GeoJSONファイルの読み込み
                </h3>
                <button onclick="closeModal('modal-import')" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
                外部のGeoJSONファイルをアップロードして、リアルタイムデータベースに一括インポートします。
            </p>
            <div class="border-2 border-dashed border-slate-300 rounded-2xl p-8 text-center hover:bg-slate-50 transition cursor-pointer" onclick="document.getElementById('import-file-input').click()">
                <i class="fa-solid fa-cloud-arrow-up text-4xl text-slate-400 mb-2"></i>
                <div class="text-xs font-bold text-slate-700">ファイルを選択してインポート</div>
                <div class="text-[10px] text-slate-400 mt-1">.geojson または .json</div>
                <input type="file" id="import-file-input" accept=".geojson,.json" class="hidden" onchange="handleFileImport(event)">
            </div>
        </div>
    </div>

    <!-- FIREBASE & APPLICATION SCRIPT -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { 
            getFirestore, 
            collection, 
            doc, 
            setDoc, 
            deleteDoc, 
            onSnapshot 
        } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Global Variables
        let map;
        let db;
        let auth;
        let currentUser = null;
        let features = [];
        let leafletLayers = {};
        let currentDrawMode = 'marker';
        let currentFilter = 'all';

        // Temporary Drawing State
        let tempPoints = [];
        let tempPolyline = null;
        let tempPolygon = null;
        let tempMarker = null;

        // Osaka Metropolitan University College of Technology (大阪公立大学工業高等専門学校) Coordinates
        const OMCT_COORDS = [34.7258, 135.6268];

        // Base Map Layers
        const baseMaps = {
            "OpenStreetMap (標準)": L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap'
            }),
            "国土地理院 (標準地図)": L.tileLayer('https://cyberjapandative.gsi.go.jp/xyz/std/{z}/{x}/{y}.png', {
                maxZoom: 18,
                attribution: '&copy; 国土地理院'
            }),
            "国土地理院 (写真/航空写真)": L.tileLayer('https://cyberjapandative.gsi.go.jp/xyz/seamlessphoto/{z}/{x}/{y}.jpg', {
                maxZoom: 18,
                attribution: '&copy; 国土地理院'
            })
        };

        // Categories Map Configuration
        const categoryConfig = {
            shelter: { label: '避難所', color: '#10b981', icon: 'fa-person-shelter' },
            hazard:  { label: '危険箇所', color: '#ef4444', icon: 'fa-triangle-exclamation' },
            water:   { label: '給水所', color: '#3b82f6', icon: 'fa-faucet-drip' },
            aed:     { label: 'AED', color: '#ec4899', icon: 'fa-heart-pulse' },
            home:    { label: '高専施設', color: '#f59e0b', icon: 'fa-graduation-cap' },
            other:   { label: 'その他', color: '#6b7280', icon: 'fa-location-dot' }
        };

        // App Initialization
        window.onload = async function() {
            initMap();
            await initFirebase();
        };

        // Initialize Map centered on Osaka Metropolitan University College of Technology
        function initMap() {
            map = L.map('map', {
                center: OMCT_COORDS,
                zoom: 16,
                layers: [baseMaps["国土地理院 (標準地図)"]]
            });

            L.control.layers(baseMaps).addTo(map);

            // Add Default College Anchor Marker
            const omctIcon = L.divIcon({
                className: 'custom-div-icon',
                html: `<div style="background-color: #1e1b4b; text-align: center; color: white; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 3px solid #6366f1; box-shadow: 0 4px 10px rgba(0,0,0,0.3);">
                        <i class="fa-solid fa-graduation-cap text-base"></i>
                       </div>`,
                iconSize: [36, 36],
                iconAnchor: [18, 18]
            });

            L.marker(OMCT_COORDS, { icon: omctIcon })
                .addTo(map)
                .bindPopup('<b class="text-sm">大阪公立大学工業高等専門学校</b><br><span class="text-xs text-slate-500">（寝屋川キャンパス）</span>');

            map.on('click', handleMapClick);
        }

        // Reset view to OMCT
        window.resetToCollege = function() {
            map.setView(OMCT_COORDS, 16, { animate: true });
        };

        // Initialize Firebase & Auth
        async function initFirebase() {
            try {
                const firebaseConfig = typeof __firebase_config !== 'undefined' 
                    ? JSON.parse(__firebase_config) 
                    : { apiKey: "demo", projectId: "demo" };

                const app = initializeApp(firebaseConfig);
                auth = getAuth(app);
                db = getFirestore(app);

                // Authentication
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }

                currentUser = auth.currentUser;
                
                if (currentUser) {
                    document.getElementById('user-id-display').innerText = 'UID: ' + currentUser.uid.substring(0, 6) + '...';
                    updateSyncBadge(true, 'リアルタイム同期完了');
                    subscribeRealtimeData();
                } else {
                    updateSyncBadge(false, '認証エラー');
                }

            } catch (err) {
                console.error("Firebase init error:", err);
                updateSyncBadge(false, 'オフラインモード');
            }
        }

        // Real-time Firestore Subscription
        function subscribeRealtimeData() {
            const appId = typeof __app_id !== 'undefined' ? __app_id : 'omct-hazard-map';
            const publicCollection = collection(db, 'artifacts', appId, 'public', 'data', 'map_features');

            onSnapshot(publicCollection, (snapshot) => {
                features = [];
                snapshot.forEach((doc) => {
                    features.push({ id: doc.id, ...doc.data() });
                });
                renderAll();
                updateSyncBadge(true, `同期中 (${features.length} 件)`);
            }, (error) => {
                console.error("Firestore error:", error);
                updateSyncBadge(false, '同期エラー');
            });
        }

        function updateSyncBadge(online, text) {
            const dot = document.getElementById('sync-dot');
            const txt = document.getElementById('sync-text');
            if (online) {
                dot.className = "w-2 h-2 rounded-full bg-emerald-400 animate-pulse";
                txt.innerText = text;
            } else {
                dot.className = "w-2 h-2 rounded-full bg-red-400";
                txt.innerText = text;
            }
        }

        // Handle Map Click Events for Drawing
        function handleMapClick(e) {
            const { lat, lng } = e.latlng;

            if (currentDrawMode === 'marker') {
                document.getElementById('input-lat').value = lat;
                document.getElementById('input-lng').value = lng;

                if (tempMarker) map.removeLayer(tempMarker);
                tempMarker = L.marker([lat, lng]).addTo(map);
                tempMarker.bindPopup("打込地点").openPopup();

            } else if (currentDrawMode === 'route') {
                tempPoints.push([lat, lng]);

                if (tempPolyline) map.removeLayer(tempPolyline);
                const strokeColor = document.getElementById('input-shape-color').value;
                tempPolyline = L.polyline(tempPoints, { color: strokeColor, weight: 5, dashArray: '5, 10' }).addTo(map);

                // Calculate distance
                const distKm = calculatePolylineDistance(tempPoints);
                document.getElementById('calc-distance-box').classList.remove('hidden');
                document.getElementById('route-distance-text').innerText = distKm.toFixed(2) + ' km';

                document.getElementById('input-geojson').value = JSON.stringify({
                    type: 'LineString',
                    coordinates: tempPoints.map(p => [p[1], p[0]])
                });

                document.getElementById('draw-instruction').innerHTML = `<i class="fa-solid fa-pen"></i> ルート作成中: ${tempPoints.length} 点指定済み (${distKm.toFixed(2)} km)。フォームのボタンを押して登録。`;

            } else if (currentDrawMode === 'zone') {
                tempPoints.push([lat, lng]);

                if (tempPolygon) map.removeLayer(tempPolygon);
                const color = document.getElementById('input-shape-color').value;
                tempPolygon = L.polygon(tempPoints, { color: color, fillColor: color, fillOpacity: 0.35 }).addTo(map);

                document.getElementById('input-geojson').value = JSON.stringify({
                    type: 'Polygon',
                    coordinates: [tempPoints.map(p => [p[1], p[0]])]
                });

                document.getElementById('draw-instruction').innerHTML = `<i class="fa-solid fa-draw-polygon"></i> 危険エリア作成中: ${tempPoints.length} 点指定済み。3点以上で確定できます。`;
            }
        }

        // Distance Calculation Utility (Haversine Formula)
        function calculatePolylineDistance(pts) {
            let total = 0;
            for (let i = 0; i < pts.length - 1; i++) {
                const p1 = L.latLng(pts[i][0], pts[i][1]);
                const p2 = L.latLng(pts[i+1][0], pts[i+1][1]);
                total += p1.distanceTo(p2);
            }
            return total / 1000; // km
        }

        // Set Active Mode
        window.setDrawMode = function(mode) {
            currentDrawMode = mode;
            clearTempDrawings();

            document.querySelectorAll('.mode-btn').forEach(btn => {
                btn.classList.remove('border-blue-500', 'text-blue-600', 'border-2');
                btn.classList.add('border-slate-200', 'text-slate-600');
            });

            const activeBtn = document.getElementById(`btn-mode-${mode}`);
            activeBtn.classList.add('border-blue-500', 'text-blue-600', 'border-2');

            const fieldsMarker = document.getElementById('fields-marker');
            const fieldsShape = document.getElementById('fields-shape');
            const fieldsContact = document.getElementById('fields-contact');
            const instruction = document.getElementById('draw-instruction');
            const distBox = document.getElementById('calc-distance-box');

            if (mode === 'marker') {
                fieldsMarker.classList.remove('hidden');
                fieldsShape.classList.add('hidden');
                fieldsContact.classList.remove('hidden');
                distBox.classList.add('hidden');
                instruction.innerHTML = '<i class="fa-solid fa-circle-info mr-1"></i> 地図上の任意の場所をクリックして、ピンを配置します。';
            } else if (mode === 'route') {
                fieldsMarker.classList.add('hidden');
                fieldsShape.classList.remove('hidden');
                fieldsContact.classList.add('hidden');
                distBox.classList.remove('hidden');
                instruction.innerHTML = '<i class="fa-solid fa-circle-info mr-1"></i> 避難経路に沿って地図上を順番にクリックしてください。';
            } else if (mode === 'zone') {
                fieldsMarker.classList.add('hidden');
                fieldsShape.classList.remove('hidden');
                fieldsContact.classList.add('hidden');
                distBox.classList.add('hidden');
                instruction.innerHTML = '<i class="fa-solid fa-circle-info mr-1"></i> 危険箇所や浸水エリアの境界線に沿ってクリックし、エリアを囲んでください。';
            }
        };

        // Handle Submit to Firestore
        window.handleFormSubmit = async function(e) {
            e.preventDefault();

            if (!currentUser) {
                alert('通信準備中です。数秒後にもう一度お試しください。');
                return;
            }

            const docId = 'item_' + Date.now();
            let newFeature = null;

            if (currentDrawMode === 'marker') {
                const lat = parseFloat(document.getElementById('input-lat').value);
                const lng = parseFloat(document.getElementById('input-lng').value);

                if (isNaN(lat) || isNaN(lng)) {
                    alert('地図をクリックして設置場所を指定してください。');
                    return;
                }

                newFeature = {
                    type: 'marker',
                    category: document.getElementById('input-category').value,
                    title: document.getElementById('input-title').value,
                    priority: document.getElementById('input-priority').value,
                    description: document.getElementById('input-description').value,
                    contact: document.getElementById('input-contact').value,
                    lat, lng,
                    updatedBy: currentUser.uid,
                    updatedAt: new Date().toISOString()
                };

            } else if (currentDrawMode === 'route' || currentDrawMode === 'zone') {
                const geojsonStr = document.getElementById('input-geojson').value;
                const title = document.getElementById('input-shape-title').value;

                if (!geojsonStr || tempPoints.length < (currentDrawMode === 'zone' ? 3 : 2)) {
                    alert(`${currentDrawMode === 'zone' ? '3点' : '2点'}以上地図上をクリックしてください。`);
                    return;
                }

                newFeature = {
                    type: currentDrawMode,
                    title: title || (currentDrawMode === 'route' ? '避難経路' : '警戒エリア'),
                    color: document.getElementById('input-shape-color').value,
                    description: document.getElementById('input-description').value,
                    geometry: JSON.parse(geojsonStr),
                    updatedBy: currentUser.uid,
                    updatedAt: new Date().toISOString()
                };
            }

            if (newFeature) {
                try {
                    const appId = typeof __app_id !== 'undefined' ? __app_id : 'omct-hazard-map';
                    const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'map_features', docId);
                    await setDoc(docRef, newFeature);

                    resetForm();
                    clearTempDrawings();
                    switchTab('list');
                } catch (err) {
                    console.error("Save error:", err);
                    alert("保存に失敗しました。");
                }
            }
        };

        // Render Features onto Map
        function renderAll() {
            Object.values(leafletLayers).forEach(layer => map.removeLayer(layer));
            leafletLayers = {};

            features.forEach(f => {
                let layer;
                if (f.type === 'marker') {
                    const cfg = categoryConfig[f.category] || categoryConfig.other;
                    
                    const customIcon = L.divIcon({
                        className: 'custom-div-icon',
                        html: `<div style="background-color: ${cfg.color}; text-align: center; color: white; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; border: 2px solid white; box-shadow: 0 3px 8px rgba(0,0,0,0.3);">
                                <i class="fa-solid ${cfg.icon} text-sm"></i>
                               </div>`,
                        iconSize: [32, 32],
                        iconAnchor: [16, 16]
                    });

                    layer = L.marker([f.lat, f.lng], { icon: customIcon }).addTo(map);

                    const popupContent = `
                        <div class="p-1 space-y-1.5 min-w-[160px]">
                            <span class="text-[10px] font-bold px-2 py-0.5 rounded text-white" style="background-color:${cfg.color}">${cfg.label}</span>
                            <h4 class="font-bold text-sm text-slate-800 leading-snug">${escapeHtml(f.title)}</h4>
                            ${f.description ? `<p class="text-xs text-slate-600">${escapeHtml(f.description)}</p>` : ''}
                            ${f.contact ? `<p class="text-xs text-blue-600 font-semibold"><i class="fa-solid fa-phone"></i> ${escapeHtml(f.contact)}</p>` : ''}
                            <div class="pt-2 border-t flex justify-end">
                                <button onclick="deleteFeature('${f.id}')" class="text-xs text-red-500 hover:text-red-700 font-bold flex items-center gap-1">
                                    <i class="fa-solid fa-trash"></i> 削除
                                </button>
                            </div>
                        </div>
                    `;
                    layer.bindPopup(popupContent);

                } else if (f.type === 'route') {
                    const latLngs = f.geometry.coordinates.map(c => [c[1], c[0]]);
                    layer = L.polyline(latLngs, { color: f.color || '#ef4444', weight: 5 }).addTo(map);
                    
                    const distKm = calculatePolylineDistance(latLngs);
                    layer.bindPopup(`
                        <div class="p-1 space-y-1">
                            <h4 class="font-bold text-sm text-slate-800">${escapeHtml(f.title)}</h4>
                            <p class="text-xs text-indigo-600 font-bold">距離: 約 ${distKm.toFixed(2)} km</p>
                            ${f.description ? `<p class="text-xs text-slate-600">${escapeHtml(f.description)}</p>` : ''}
                            <div class="pt-2 border-t flex justify-end">
                                <button onclick="deleteFeature('${f.id}')" class="text-xs text-red-500 font-bold"><i class="fa-solid fa-trash"></i> 削除</button>
                            </div>
                        </div>
                    `);

                } else if (f.type === 'zone') {
                    const latLngs = f.geometry.coordinates[0].map(c => [c[1], c[0]]);
                    layer = L.polygon(latLngs, { color: f.color || '#ef4444', fillColor: f.color, fillOpacity: 0.35 }).addTo(map);
                    layer.bindPopup(`
                        <div class="p-1 space-y-1">
                            <h4 class="font-bold text-sm text-slate-800">${escapeHtml(f.title)}</h4>
                            ${f.description ? `<p class="text-xs text-slate-600">${escapeHtml(f.description)}</p>` : ''}
                            <div class="pt-2 border-t flex justify-end">
                                <button onclick="deleteFeature('${f.id}')" class="text-xs text-red-500 font-bold"><i class="fa-solid fa-trash"></i> 削除</button>
                            </div>
                        </div>
                    `);
                }

                if (layer) leafletLayers[f.id] = layer;
            });

            renderList();
            renderStats();
        }

        // Render List Tab
        function renderList() {
            const container = document.getElementById('items-container');
            const searchKeyword = document.getElementById('search-list').value.toLowerCase();
            container.innerHTML = '';

            const filtered = features.filter(f => {
                const matchesCategory = (currentFilter === 'all') || (f.category === currentFilter);
                const matchesSearch = (f.title && f.title.toLowerCase().includes(searchKeyword)) ||
                                      (f.description && f.description.toLowerCase().includes(searchKeyword));
                return matchesCategory && matchesSearch;
            });

            document.getElementById('list-count').innerText = filtered.length;
            document.getElementById('total-count').innerText = features.length;

            if (filtered.length === 0) {
                container.innerHTML = '<div class="text-center py-8 text-xs text-slate-400">表示できる登録データがありません</div>';
                return;
            }

            filtered.forEach(f => {
                const item = document.createElement('div');
                item.className = "bg-white p-3 rounded-xl border border-slate-200 hover:border-blue-400 shadow-sm transition flex justify-between items-start gap-2 cursor-pointer";

                let iconClass = "fa-route text-purple-500";
                let label = "避難経路";

                if (f.type === 'marker') {
                    const cfg = categoryConfig[f.category] || categoryConfig.other;
                    iconClass = `${cfg.icon}`;
                    label = cfg.label;
                } else if (f.type === 'zone') {
                    iconClass = "fa-draw-polygon text-red-500";
                    label = "警戒エリア";
                }

                item.innerHTML = `
                    <div class="flex-1" onclick="focusFeature('${f.id}')">
                        <div class="flex items-center gap-1.5 mb-1">
                            <i class="fa-solid ${iconClass} text-xs"></i>
                            <span class="text-[10px] font-bold text-slate-500">${label}</span>
                        </div>
                        <h4 class="font-bold text-xs text-slate-800 leading-snug">${escapeHtml(f.title)}</h4>
                        ${f.description ? `<p class="text-[11px] text-slate-500 line-clamp-1 mt-0.5">${escapeHtml(f.description)}</p>` : ''}
                    </div>
                    <button onclick="deleteFeature('${f.id}')" class="text-slate-300 hover:text-red-500 p-1 transition">
                        <i class="fa-solid fa-trash-can text-sm"></i>
                    </button>
                `;
                container.appendChild(item);
            });
        }

        // Render Stats
        function renderStats() {
            const counts = { shelter: 0, hazard: 0, water: 0, aed: 0, route: 0, zone: 0 };
            
            features.forEach(f => {
                if (f.type === 'marker' && counts[f.category] !== undefined) {
                    counts[f.category]++;
                } else if (f.type === 'route') {
                    counts.route++;
                } else if (f.type === 'zone') {
                    counts.zone++;
                }
            });

            document.getElementById('stat-shelter').innerText = counts.shelter;
            document.getElementById('stat-hazard').innerText = counts.hazard;
            document.getElementById('stat-water').innerText = counts.water;
            document.getElementById('stat-aed').innerText = counts.aed;
            document.getElementById('stat-route').innerText = counts.route;
            document.getElementById('stat-zone').innerText = counts.zone;
            document.getElementById('stat-total').innerText = features.length;
        }

        // Focus Map on Feature
        window.focusFeature = function(id) {
            const layer = leafletLayers[id];
            const f = features.find(item => item.id === id);

            if (layer && f) {
                if (f.type === 'marker') {
                    map.setView([f.lat, f.lng], 17);
                    layer.openPopup();
                } else if (f.type === 'route' || f.type === 'zone') {
                    map.fitBounds(layer.getBounds(), { padding: [30, 30] });
                    layer.openPopup();
                }
            }
        };

        // Delete Item from Firestore
        window.deleteFeature = async function(id) {
            if (confirm('この項目をリアルタイムマップから削除しますか？（他の共有ユーザー画面からも消去されます）')) {
                try {
                    const appId = typeof __app_id !== 'undefined' ? __app_id : 'omct-hazard-map';
                    const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'map_features', id);
                    await deleteDoc(docRef);
                } catch (err) {
                    console.error("Delete error:", err);
                    alert("削除に失敗しました。");
                }
            }
        };

        // Helper Clear Temp Drawing
        function clearTempDrawings() {
            if (tempMarker) map.removeLayer(tempMarker);
            if (tempPolyline) map.removeLayer(tempPolyline);
            if (tempPolygon) map.removeLayer(tempPolygon);
            tempPoints = [];
            tempMarker = tempPolyline = tempPolygon = null;
            document.getElementById('input-lat').value = '';
            document.getElementById('input-lng').value = '';
            document.getElementById('input-geojson').value = '';
            document.getElementById('calc-distance-box').classList.add('hidden');
        }

        function resetForm() {
            document.getElementById('feature-form').reset();
        }

        // UI Tabs & Filters
        window.switchTab = function(tabName) {
            ['add', 'list', 'stats'].forEach(t => {
                document.getElementById(`content-${t}`).classList.add('hidden');
                const tabBtn = document.getElementById(`tab-${t}`);
                tabBtn.classList.remove('text-blue-600', 'border-b-2', 'border-blue-600');
                tabBtn.classList.add('text-slate-500');
            });

            document.getElementById(`content-${tabName}`).classList.remove('hidden');
            const activeTab = document.getElementById(`tab-${tabName}`);
            activeTab.classList.add('text-blue-600', 'border-b-2', 'border-blue-600');
            activeTab.classList.remove('text-slate-500');
        };

        window.filterList = function(cat) {
            currentFilter = cat;
            renderList();
        };

        // GeoJSON Export
        window.exportGeoJSON = function() {
            const geojson = {
                type: "FeatureCollection",
                features: features.map(f => {
                    let geometry = null;
                    if (f.type === 'marker') {
                        geometry = { type: "Point", coordinates: [f.lng, f.lat] };
                    } else {
                        geometry = f.geometry;
                    }

                    return {
                        type: "Feature",
                        properties: { ...f },
                        geometry
                    };
                })
            };

            downloadFile(JSON.stringify(geojson, null, 2), 'omct_hazard_map.geojson', 'application/json');
            closeModal('modal-export');
        };

        // CSV Export
        window.exportCSV = function() {
            let csv = "\uFEFFID,種類,名称,重要度,詳細説明,連絡先,緯度,経度\n";
            features.filter(f => f.type === 'marker').forEach(f => {
                csv += `"${f.id}","${f.category}","${f.title}","${f.priority}","${f.description || ''}","${f.contact || ''}",${f.lat},${f.lng}\n`;
            });

            downloadFile(csv, 'omct_hazard_spots.csv', 'text/csv');
            closeModal('modal-export');
        };

        // File Import
        window.handleFileImport = async function(e) {
            const file = e.target.files[0];
            if (!file || !currentUser) return;

            const reader = new FileReader();
            reader.onload = async function(event) {
                try {
                    const json = JSON.parse(event.target.result);
                    if (json.type === "FeatureCollection" && Array.isArray(json.features)) {
                        const appId = typeof __app_id !== 'undefined' ? __app_id : 'omct-hazard-map';
                        
                        for (const item of json.features) {
                            const props = item.properties || {};
                            const docId = 'item_' + Date.now() + '_' + Math.floor(Math.random()*1000);
                            let newFeature = null;

                            if (item.geometry.type === "Point") {
                                newFeature = {
                                    type: 'marker',
                                    category: props.category || 'other',
                                    title: props.title || 'インポート地点',
                                    priority: props.priority || 'medium',
                                    description: props.description || '',
                                    contact: props.contact || '',
                                    lng: item.geometry.coordinates[0],
                                    lat: item.geometry.coordinates[1],
                                    updatedBy: currentUser.uid,
                                    updatedAt: new Date().toISOString()
                                };
                            } else if (item.geometry.type === "LineString") {
                                newFeature = {
                                    type: 'route',
                                    title: props.title || '避難経路',
                                    color: props.color || '#ef4444',
                                    description: props.description || '',
                                    geometry: item.geometry,
                                    updatedBy: currentUser.uid,
                                    updatedAt: new Date().toISOString()
                                };
                            } else if (item.geometry.type === "Polygon") {
                                newFeature = {
                                    type: 'zone',
                                    title: props.title || '警戒エリア',
                                    color: props.color || '#ef4444',
                                    description: props.description || '',
                                    geometry: item.geometry,
                                    updatedBy: currentUser.uid,
                                    updatedAt: new Date().toISOString()
                                };
                            }

                            if (newFeature) {
                                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'map_features', docId);
                                await setDoc(docRef, newFeature);
                            }
                        }

                        alert('GeoJSONデータを共同マップへ正常に同期しました。');
                        closeModal('modal-import');
                    }
                } catch (err) {
                    console.error("Import error:", err);
                    alert('ファイルの読み込みに失敗しました。');
                }
            };
            reader.readAsText(file);
        };

        function downloadFile(content, fileName, contentType) {
            const a = document.createElement("a");
            const file = new Blob([content], { type: contentType });
            a.href = URL.createObjectURL(file);
            a.download = fileName;
            a.click();
        }

        window.openExportModal = () => document.getElementById('modal-export').classList.remove('hidden');
        window.openImportModal = () => document.getElementById('modal-import').classList.remove('hidden');
        window.closeModal = (id) => document.getElementById(id).classList.add('hidden');
        window.toggleSidebar = () => document.getElementById('sidebar').classList.toggle('-translate-x-full');

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }
    </script>
</body>
</html>
